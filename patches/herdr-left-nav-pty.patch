diff --git a/src/app/sidebar_pty.rs b/src/app/sidebar_pty.rs
new file mode 100644
index 00000000..467231b4
--- /dev/null
+++ b/src/app/sidebar_pty.rs
@@ -0,0 +1,159 @@
+use std::path::PathBuf;
+
+use tracing::warn;
+
+use crate::app::App;
+use crate::layout::PaneId;
+use crate::pane::PaneLaunchEnv;
+use crate::terminal::{TerminalId, TerminalRuntime, TerminalState};
+
+fn default_sidebar_pty_cwd() -> PathBuf {
+    #[cfg(windows)]
+    const HOME_VAR: &str = "USERPROFILE";
+    #[cfg(unix)]
+    const HOME_VAR: &str = "HOME";
+    std::env::var_os(HOME_VAR)
+        .map(PathBuf::from)
+        .unwrap_or_else(|| std::env::current_dir().unwrap_or_else(|_| PathBuf::from("/")))
+}
+
+impl App {
+    /// Spawn the embedded sidebar terminal from config. A no-op when the
+    /// command is unset or a sidebar pty is already running; spawn failures
+    /// leave the section disabled instead of failing startup.
+    pub(crate) fn spawn_sidebar_pty(&mut self, config: &crate::config::SidebarPtyConfig) {
+        let Some(command) = config.enabled_command() else {
+            return;
+        };
+        if self.state.sidebar_pty.is_some() {
+            return;
+        }
+        let cwd = config
+            .cwd
+            .clone()
+            .map(PathBuf::from)
+            .unwrap_or_else(default_sidebar_pty_cwd);
+        let cols = crate::ui::sidebar_pty_grid_cols(self.state.sidebar_width);
+        let rows = crate::ui::sidebar_pty_rows_for_width(cols, config.rows);
+        let pane_id = PaneId::alloc();
+        let terminal_id = TerminalId::alloc();
+        let launch_env = PaneLaunchEnv::from_extra(Vec::new()).without_pane_identity();
+        let runtime = TerminalRuntime::spawn_shell_command(
+            pane_id,
+            rows,
+            cols,
+            cwd.clone(),
+            command,
+            &launch_env,
+            crate::pane::AgentDetection::Disabled,
+            self.state.pane_scrollback_limit_bytes,
+            self.state.host_terminal_theme,
+            self.state.host_terminal_appearance,
+            self.event_tx.clone(),
+            self.render_notify.clone(),
+            self.render_dirty.clone(),
+        );
+        match runtime {
+            Ok(runtime) => {
+                self.terminal_runtimes.insert(terminal_id.clone(), runtime);
+                self.state.terminals.insert(
+                    terminal_id.clone(),
+                    TerminalState::new(terminal_id.clone(), cwd),
+                );
+                self.state.sidebar_pty = Some(crate::app::state::SidebarPtyState {
+                    pane_id,
+                    terminal_id,
+                    rows_override: config.rows,
+                });
+            }
+            Err(err) => {
+                warn!(command, err = %err, "failed to spawn sidebar pty command");
+            }
+        }
+    }
+
+    pub(crate) fn close_sidebar_pty(&mut self) -> bool {
+        let Some(pty) = self.state.sidebar_pty.take() else {
+            return false;
+        };
+        self.state.terminals.remove(&pty.terminal_id);
+        self.shutdown_terminal_runtime(pty.terminal_id);
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn test_app() -> App {
+        let (_api_tx, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        App::new(
+            &crate::config::Config::default(),
+            true,
+            None,
+            api_rx,
+            crate::api::EventHub::default(),
+        )
+    }
+
+    fn install_test_sidebar_pty(app: &mut App) -> (PaneId, TerminalId) {
+        let pane_id = PaneId::alloc();
+        let terminal_id = TerminalId::alloc();
+        app.state.terminals.insert(
+            terminal_id.clone(),
+            TerminalState::new(terminal_id.clone(), PathBuf::from("/sidebar-pty")),
+        );
+        app.state.sidebar_pty = Some(crate::app::state::SidebarPtyState {
+            pane_id,
+            terminal_id: terminal_id.clone(),
+            rows_override: None,
+        });
+        (pane_id, terminal_id)
+    }
+
+    #[test]
+    fn spawn_is_a_no_op_without_a_command() {
+        let mut app = test_app();
+
+        app.spawn_sidebar_pty(&crate::config::SidebarPtyConfig::default());
+
+        assert!(app.state.sidebar_pty.is_none());
+        assert!(app.state.terminals.is_empty());
+    }
+
+    #[test]
+    fn close_removes_terminal_state_and_reports_closed() {
+        let mut app = test_app();
+        let (_pane_id, terminal_id) = install_test_sidebar_pty(&mut app);
+
+        assert!(app.close_sidebar_pty());
+
+        assert!(app.state.sidebar_pty.is_none());
+        assert!(!app.state.terminals.contains_key(&terminal_id));
+        assert!(!app.close_sidebar_pty());
+    }
+
+    #[test]
+    fn pane_died_for_sidebar_pty_clears_the_section() {
+        let mut app = test_app();
+        let (pane_id, terminal_id) = install_test_sidebar_pty(&mut app);
+
+        app.handle_internal_event(crate::events::AppEvent::PaneDied { pane_id });
+
+        assert!(app.state.sidebar_pty.is_none());
+        assert!(!app.state.terminals.contains_key(&terminal_id));
+    }
+
+    #[test]
+    fn sidebar_pty_survives_state_invariants_without_workspaces() {
+        let mut app = test_app();
+        install_test_sidebar_pty(&mut app);
+
+        app.state.assert_invariants_for_test();
+
+        assert!(app.state.sidebar_pty.is_some());
+    }
+}

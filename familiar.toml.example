# familiar.toml — local/private Familiar configuration schema.
#
# Copy to `familiar.toml`, edit it, then `chmod 600 familiar.toml`. Every key is
# optional. Keys are flattened, uppercased, and exported with one FAMILIAR_
# prefix: `brave_api_key` -> FAMILIAR_BRAVE_API_KEY and `[theme] accent` ->
# FAMILIAR_THEME_ACCENT. Ambient FAMILIAR_* variables override this file.
# See docs/CONFIG.md for types, normalization, precedence, and restart behavior.

# Runtime policy. Familiar bridges these generic names to the upstream PI_*
# variables expected by pi.
pi_telemetry = 0
pi_offline = 1
pi_skip_version_check = 1

# Paths and model/service examples.
# pi_coding_agent_dir = "./state/pi"
# identity_path = "./identity"
# age_key = "./state/age.key"
# handoff_path = "./state/handoffs"
# handoff_prompt_path = "/private/path/prompt.md.age"
# worklist_dir = "./state/worklist"   # canonical; inbox_dir still read for one release
# model_dir = "./models"
# log_path = "./state/log.jsonl"
# herdr_session = "familiar"
# herdr_config_path = "./state/herdr/config.toml"
# model_file = "model.gguf"                 # set file + URL together
# model_url = "https://models.example.invalid/model.gguf"
# llama_base_url = "https://llama.example.invalid" # omit to spawn local
# default_provider = "llama.cpp"
# default_model = "provider/model-id"
# stt_url = "https://stt.example.invalid"   # omit to spawn local
# tts_url = "https://tts.example.invalid"   # omit to spawn local
# tts_voice = "af_exo"
# stt_model_file = "stt.gguf"
# stt_model_url = "https://models.example.invalid/stt.gguf"
# tts_model_file = "tts.gguf"
# tts_model_url = "https://models.example.invalid/tts.gguf"

# Provider configuration. These remain FAMILIAR_* in local configuration;
# Familiar bridges them to ANTHROPIC_* only when launching upstream consumers.
# Never put real credentials in this committed example.
# anthropic_base_url = "https://gateway.example.invalid"
# anthropic_api_key = "replace-locally"
# anthropic_auth_token = "replace-locally"

# Web tools and subagents.
# searxng_url = "https://search.example.invalid"
# brave_api_key = "replace-locally"
# brave_url = "https://api.search.brave.com"
# fetch_allow_private = false
# subagent_mode = "herdr"
# subagent_model = "anthropic/claude-haiku-4-5"
# subagent_timeout = 1800
# subagent_dir = "./state/subagents"
# subagent_session_dir = "./state/pi/subagent-sessions"
# artifact_dir = "./state/artifacts"
# subscriber_port = 1692
# zip_model = "anthropic/claude-haiku-4-5"
# tz = "America/Chicago"
# debug_level = "debug"

# The landed unified theme owns this section and is preserved alongside the
# generic schema. Omit any key to keep the built-in Spectrum default.
# Colors accept #rgb, #rrggbb, or #rrggbbaa; invalid colors fail boot loudly.
# See docs/THEME.md for the full role × consumer matrix.

[theme]
name = "familiar-monokai-pro-spectrum"

# --- Semantic roles --------------------------------------------------------
background  = "#222222"  # Ghostty Spectrum app/terminal backdrop
surface     = "#191919"  # raised panels (local Spectrum UI level)
surface_dim = "#131313"  # deepest recess
overlay     = "#363537"  # hairlines / raised-on-surface
text        = "#f7f1ff"  # primary foreground
muted       = "#bab6c0"  # secondary text
accent      = "#5ad4e6"  # Spectrum cyan; legible Familiar mark
success     = "#7bd88f"
warning     = "#fce566"
error       = "#fc618d"
border       = "#363537"
border_muted = "#525053"
selection_bg = "#525053"  # Ghostty selection background
cursor       = "#bab6c0"  # Ghostty cursor
cursor_text  = "#222222"  # adapted for readable glyph contrast

# --- Terminal ANSI 16-color palette ---------------------------------------
# Drives restty browser panes (colors.palette[0..15]) and is exported as
# FAMILIAR_ANSI_0..15 for newly opened herdr panes (env handoff; herdr has no
# native per-pane ANSI-16 key).
[theme.ansi]
black   = "#222222"
red     = "#fc618d"
green   = "#7bd88f"
yellow  = "#fce566"
blue    = "#fd9353"  # Ghostty Spectrum's intentional ANSI mapping
magenta = "#948ae3"
cyan    = "#5ad4e6"
white   = "#f7f1ff"
bright_black   = "#69676c"
bright_red     = "#fc618d"
bright_green   = "#7bd88f"
bright_yellow  = "#fce566"
bright_blue    = "#fd9353"
bright_magenta = "#948ae3"
bright_cyan    = "#5ad4e6"
bright_white   = "#f7f1ff"

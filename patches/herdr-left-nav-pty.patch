+    /// Forward a mouse event inside the sidebar pty grid to its child via the
+    /// terminal mouse protocols. Returns true when the event was inside the
+    /// grid and is consumed, even if the child has mouse reporting disabled —
+    /// the process inside owns all behavior, so nothing else may react.
+    fn forward_sidebar_pty_mouse(
+        &self,
+        terminal_runtimes: &TerminalRuntimeRegistry,
+        mouse: MouseEvent,
+    ) -> bool {
+        let Some(pty) = self.sidebar_pty.as_ref() else {
+            return false;
+        };
+        let Some(grid) = crate::ui::sidebar_pty_grid_rect(self, self.view.sidebar_rect) else {
+            return false;
+        };
+        if !rect_contains(grid, mouse.column, mouse.row) {
+            return false;
+        }
+        let Some(rt) = terminal_runtimes.get(&pty.terminal_id) else {
+            return true;
+        };
+        let Some(position) = self.pane_mouse_position(rt, grid, mouse) else {
+            return true;
+        };
+        let bytes = match mouse.kind {
+            MouseEventKind::Down(_) | MouseEventKind::Up(_) | MouseEventKind::Drag(_) => {
+                rt.encode_mouse_button(mouse.kind, position, mouse.modifiers)
+            }
+            MouseEventKind::Moved => rt.encode_mouse_motion(mouse.kind, position, mouse.modifiers),
+            MouseEventKind::ScrollUp
+            | MouseEventKind::ScrollDown
+            | MouseEventKind::ScrollLeft
+            | MouseEventKind::ScrollRight => {
+                rt.encode_mouse_wheel(mouse.kind, position, mouse.modifiers)
+            }
+        };
+        let Some(bytes) = bytes else {
+            return true;
+        };
+        if let Err(err) = rt.try_send_bytes(Bytes::from(bytes)) {
+            warn!(err = %err, kind = ?mouse.kind, "failed to forward sidebar pty mouse event");
+        }
+        true
+    }

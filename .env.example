# familiar environment — copy to .env and edit; .env is gitignored.
# familiar.sh sources .env with `set -a`, so every entry is exported to
# all children (pi, llama, stt, tts) without needing `export` prefixes.

## pi behavior
# Disable install telemetry.
PI_TELEMETRY=0
# Disable startup network operations (auto-update, catalog refresh);
# versioning is owned by the flake.
PI_OFFLINE=1
PI_SKIP_VERSION_CHECK=1

## familiar services
# FAMILIAR_MODEL_DIR=/path/to/models
# FAMILIAR_SUBSCRIBER_PORT=1692
# If the *_URL vars below are unset, familiar spawns and supervises the
# service itself (llama on 9931; stt/tts not yet implemented). Set a URL
# to use an external service instead.
# LLAMA_BASE_URL=
# FAMILIAR_STT_URL=
# FAMILIAR_TTS_URL=

## anthropic gateway (not yet wired)
# Point pi's anthropic provider at an alternate Anthropic-compatible
# gateway. Auth uses pi's native ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

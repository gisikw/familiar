FAMILIAR_SPAN_MODEL="anthropic/claude-haiku
# familiar environment — copy to .env and edit; .env is gitignored.
# familiar.sh sources .env with `set -a`, so every entry is exported to
# all children (pi, llama, stt, tts) without needing `export` prefixes.
#
# Convention: FAMILIAR_*_URL set = "someone provides this service, don't
# spawn local"; unset = familiar provides the floor itself. Flake-provided
# values (models) are floors; .env is sourced after and overrides them.

## pi behavior
# Disable install telemetry.
PI_TELEMETRY=0
# Disable startup network operations (auto-update, catalog refresh);
# versioning is owned by the flake.
PI_OFFLINE=1
PI_SKIP_VERSION_CHECK=1

## paths & state (defaults shown; rarely need changing)
# Session/settings storage. Overriding this is the deliberate escape hatch
# for a wedged session: point at a clean-room dir, segmented off the main
# continuity line. See familiar.sh.
# PI_CODING_AGENT_DIR=./state/pi
# FAMILIAR_IDENTITY_PATH=./identity
# FAMILIAR_AGE_KEY=./state/age.key
# FAMILIAR_HANDOFF_PATH=./state/handoffs
# Override the handoff-turn prompt (plain file or .age; repo is public,
# a personal prompt belongs outside it).
# FAMILIAR_HANDOFF_PROMPT_PATH=
# FAMILIAR_MODEL_DIR=./models
# FAMILIAR_LOG_PATH=./state/log.jsonl

## brains
# Floor model (flake provides gemma; override file+URL together).
# FAMILIAR_MODEL_FILE=
# FAMILIAR_MODEL_URL=
# External llama-server; unset = familiar spawns one on 9931.
# LLAMA_BASE_URL=
# Seed pi's default model choice (only when no persisted choice exists;
# provider defaults to llama.cpp).
# FAMILIAR_DEFAULT_PROVIDER=
# FAMILIAR_DEFAULT_MODEL=
# Anthropic-compatible gateway for pi's anthropic provider.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

## speech
# External STT/TTS; unset = familiar spawns local (stt 9932, tts 9933).
# FAMILIAR_STT_URL=
# FAMILIAR_TTS_URL=
# Voice for synthesis (baked voices live in identity/voices/kokoro/).
# FAMILIAR_TTS_VOICE=af_exo
# Local speech model floors (flake provides parakeet/kokoro).
# FAMILIAR_STT_MODEL_FILE=
# FAMILIAR_STT_MODEL_URL=
# FAMILIAR_TTS_MODEL_FILE=
# FAMILIAR_TTS_MODEL_URL=

## web tools (extensions/web.ts)
# Search tiers: SearXNG if set, else Brave if key set, else keyless
# DuckDuckGo floor. Fetch is always local (no proxy, no key).
# FAMILIAR_SEARXNG_URL=
# FAMILIAR_BRAVE_API_KEY=
# FAMILIAR_BRAVE_URL=

## subagents (extensions/subagent.ts)
# Default model for dispatched drones (pi --model pattern:
# provider/id[:thinking]). Unset = children resolve pi's own default —
# typically the dispatcher's (expensive) model. Per-call `model` overrides.
# FAMILIAR_SUBAGENT_MODEL=anthropic/claude-haiku-4-5
# Wall-clock seconds before a drone is killed and settled as timeout.
# FAMILIAR_SUBAGENT_TIMEOUT=1800
# Spool (durable job state) and child session storage. Children get their
# own session dir so `pi --continue` can never resume a drone as the
# familiar.
# FAMILIAR_SUBAGENT_DIR=./state/subagents
# FAMILIAR_SUBAGENT_SESSION_DIR=$PI_CODING_AGENT_DIR/subagent-sessions

## subscriber (voice/text ingress + SSE egress)
# FAMILIAR_SUBSCRIBER_PORT=1692

## spans (extensions/spans.ts) — semantic tagging + span summarization
# Summarizer model for collapsing tagged spans (pi --model pattern). Cheap
# by default and deliberately so: the full transcript stays on disk and
# stays readable, so the summary only has to carry the gist. Editorial
# judgment lives in the span *name*, which is the tagger's call.
# FAMILIAR_SPAN_MODEL=anthropic/claude-haiku-4-5
# Lazy-job escalation defaults: a deferred summarization waits for a cheap
# moment, but runs anyway after this many turns...
# FAMILIAR_SPAN_MAX_TURNS=10
# ...or once context saturation passes this percent.
# FAMILIAR_SPAN_SATURATION=70

## tuning
# Timezone for timestamps/timegap (default America/Chicago).
# FAMILIAR_TZ=
# Extension debug logging: off | error | debug (default debug).
# FAMILIAR_DEBUG_LEVEL=
